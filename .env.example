# Required for Deep mode synthesis
GEMINI_API_KEY=

# Optional model override
GEMINI_MODEL=gemini-2.5-flash

# Optional macro evidence. If absent, Deep continues without FRED.
FRED_API_KEY=

# Optional SEC automated-access identifier. Warren has a repository URL default,
# but production deployments should provide an identifying application/contact value.
SEC_USER_AGENT=WarrenStockIntelligence/0.3 contact@example.com
